pub fn create(name String) Room:
    return {
        name: name
    }

fn has(fd i32) bool:
    for member in self.members:
        if member.fd == fd:
            return True
    return False

fn remove(fd i32):
    for i in Range::create(0, self.members.len()):
        if self.members[i].fd == fd:
            self.members.pop(i)
            return

fn say(text String, except_fd i32):
    line String = $"{text}\n"
    for member in self.members:
        if member.fd != except_fd:
            member.send(line)
