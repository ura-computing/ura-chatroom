pub fn create(nick String, port i32) Client:
    address net::Address = net::Address::create(HOST, port)
    socket net::Socket = net::Socket::create()
    socket.connect(&address)
    return {
        socket: socket,
        nick: nick
    }

fn say(text String):
    self.socket.send($"{text}\n")

fn prompt():
    io::out("\e[90m>\e[0m ")

fn run():
    self.say($"HELLO {self.nick}")

    sockets Array<net::Socket>
    sockets.append({ fd: STDIN })
    sockets.append(self.socket)

    pending String = ""

    while True:
        ready Array<i16> = net::poll(&sockets, cstd::POLLIN, -1)

        if (ready[0] & cstd::POLLIN) != 0:
            line String = io::input()
            io::out("\e[1A\e[2K")
            if self.typed(line):
                break
            self.prompt()

        if (ready[1] & cstd::POLLIN) != 0:
            chunk String = self.socket.recv(CHUNK)
            if chunk.is_empty():
                io::out("\r\e[2K")
                log::stamp("\e[31m", "closed", "the server closed the connection")
                break

            pending += chunk

            while True:
                at i32 = pending.find("\n")
                if at < 0:
                    break
                self.show(pending.substr(0, at).trim())
                pending = pending.substr(at + 1, pending.len() - at - 1)

    self.socket.close()
