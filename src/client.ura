use "@/core"
use "@/posix"
use "./log"
use "./banner"
use "./protocol"
use "./donut"

HOST String = "127.0.0.1"
PORT i32 = 6667
CHUNK i32 = 512
STDIN i32 = 0

struct Client:
    socket net::Socket
    nick String
    room String
    use "./client/methods"
    use "./client/typed"
    use "./client/show"

fn main() i32:
    nick String = "guest"
    port i32 = PORT
    if os::argc > 1:
        nick = os::argv[1]
    if os::argc > 2:
        port = os::argv[2].to_int()
    try:
        client Client = Client::create(nick, port)
        banner::client(port)
        client.run()
    catch e Error:
        log::stamp("\e[31m", "error", $"can't connect to port {port}: {e.message}")
        return 1
    return 0
