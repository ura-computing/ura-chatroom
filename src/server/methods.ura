pub fn create(port i32) Server:
    return {
        listener: net::Server::create(port, BACKLOG)
    }

fn run():
    while True:
        sockets Array<net::Socket>
        sockets.append(self.listener.socket)
        for user in self.users:
            sockets.append(user.socket)

        ready Array<i16> = net::poll(&sockets, cstd::POLLIN, -1)

        if (ready[0] & cstd::POLLIN) != 0:
            self.admit()

        i i32 = ready.len() - 1
        while i >= 1:
            if (ready[i] & cstd::POLLIN) != 0:
                self.receive(i - 1)
            i -= 1

fn admit():
    try:
        socket net::Socket = self.listener.accept()
        self.users.append(User::create(socket))
        log::stamp("\e[32m", "connect", $"fd {socket.fd}")
    catch e Error:
        log::stamp("\e[31m", "error", $"accept: {e.message}")

fn receive(index i32):
    chunk String
    try:
        chunk = self.users[index].socket.recv(CHUNK)
    catch e Error:
        self.quit(index, e.message)
        return
    if chunk.is_empty():
        self.quit(index, "connection closed")
        return

    self.users[index].buffer += chunk

    while True:
        at i32 = self.users[index].buffer.find("\n")
        if at < 0:
            return

        size i32 = self.users[index].buffer.len()
        line String = self.users[index].buffer.substr(0, at).trim()
        rest String = self.users[index].buffer.substr(at + 1, size - at - 1)
        self.users[index].buffer = rest

        is_quit bool = False
        try:
            is_quit = self.command(index, line)
        catch e Error:
            self.users[index].say($"ERROR {e.message}")
            log::stamp("\e[31m", "error", $"{self.users[index]}: {e.message}")

        if is_quit:
            return

fn find_user(nick String) i32:
    for i in Range::create(0, self.users.len()):
        if self.users[i].nick == nick:
            return i
    return -1

fn find_room(name String) i32:
    for i in Range::create(0, self.rooms.len()):
        if self.rooms[i].name == name:
            return i
    return -1

fn unique(nick String) String:
    if self.find_user(nick) < 0:
        return nick

    n i32 = 2
    while True:
        candidate String = $"{nick}{n}"
        if self.find_user(candidate) < 0:
            return candidate
        n += 1
    return nick
