use "@/posix"

mod log:
    CLOCK_SIZE i32 = 16

    fn clock() String:
        text String
        text.resize(CLOCK_SIZE)
        now i64 = cstd::time(null)
        date cstd::tm
        cstd::localtime_r(&now, &date)
        size i64 = cstd::strftime(text.data, CLOCK_SIZE as i64, "%H:%M:%S", &date)
        text.resize(size as i32)
        return text

    fn stamp(color String, tag String, text String):
        io::out($"\e[90m{clock()}\e[0m  {color}{tag}\e[0m  {text}\n")
