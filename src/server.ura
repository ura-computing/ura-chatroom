use "@/core"
use "@/posix"
use "./log"
use "./banner"
use "./protocol"
use "./emoji"
use "./fun"
use "./chat/user"
use "./chat/room"

PORT i32 = 6667
BACKLOG i32 = 16
CHUNK i32 = 512

struct Server:
    listener net::Server
    users Array<User>
    rooms Array<Room>
    use "./server/methods"
    use "./server/commands"
    use "./server/extras"

use "./server/operators"

fn main() i32:
    port i32 = PORT
    if os::argc > 1:
        port = os::argv[1].to_int()
    fun::seed()
    try:
        server Server = Server::create(port)
        banner::server(port)
        server.run()
    catch e Error:
        log::stamp("\e[31m", "error", $"can't listen on port {port}: {e.message}")
        return 1
    return 0
